<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (DD310), ported from claude-tray's, which passed certification.
  build\build-msix.ps1 fills {VERSION} from <Version> in Directory.Build.props, so the version
  still lives in one place; the Store requires the fourth part to be 0.

  Identity is provisional. The Store signs the package and refuses an upload whose Name and
  Publisher differ from the Partner Center reservation, and FreeHarbor has none yet: until it
  does, these are the values a sideloaded build signs with. Replacing them is the only edit
  the reservation needs.

  Write virtualization is off (DD309, docs/specs/DD309-msix-virtualization.md). With it on, the
  app writes its root into the package's LocalCache while the WSL import is handed the real
  path, and WslService, which runs outside the package, finds nothing there. unvirtualizedResources
  is a restricted capability, so the submission has to say why: the app hands paths to a Windows
  service outside the package, and that service has to find the files.

  The command line (DD312): a folder under WindowsApps cannot be launched from outside, so the
  installer's PATH entry becomes two execution aliases, freeharbor.exe on the tray and docker.exe
  on a second, unlisted application whose executable is the console forwarder. Aliases land in
  %LOCALAPPDATA%\Microsoft\WindowsApps, late on PATH. The docker-desktop:// handler (DD314)
  arrives with its own task.

  Start with Windows (DD313): a package's HKCU Run values are written where nothing launches them,
  so the installer's two Run values (DD97) become two startup tasks. The tray's is on, as the
  installer's checkbox is ticked by default; launched by it, the tray opens no window (DD311). The
  engine's runs the same exe with the run verb, through a third unlisted application, and is off, because
  the engine never starts unasked. The user changes either in Settings > Apps > Startup.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 desktop desktop6 rescap">

  <Identity Name="Alegauss.FreeHarbor"
            Publisher="CN=FreeHarbor Sideload"
            Version="{VERSION}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>FreeHarbor</DisplayName>
    <PublisherDisplayName>Alegauss</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <!-- 19041 is Windows 10 2004, the first build installer.iss accepts for WSL2. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="pt-br" />
  </Resources>

  <Applications>
    <Application Id="FreeHarbor" Executable="FreeHarbor.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="FreeHarbor"
        Description="Docker on Windows, built for your coding agent."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="freeharbor.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="FreeHarborTray" Enabled="true" DisplayName="FreeHarbor" />
        </desktop:Extension>
      </Extensions>
    </Application>
    <!-- The engine at sign-in: the same exe serving the engine, off unless the user turns it on. -->
    <Application Id="Engine" Executable="FreeHarbor.exe" EntryPoint="Windows.FullTrustApplication"
                 uap10:Parameters="--run">
      <uap:VisualElements
        DisplayName="FreeHarbor engine"
        Description="Starts FreeHarbor's engine at sign-in."
        BackgroundColor="transparent"
        AppListEntry="none"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="FreeHarborEngine" Enabled="false" DisplayName="FreeHarbor engine" />
        </desktop:Extension>
      </Extensions>
    </Application>
    <!-- The docker forwarder (DD141), console subsystem, which an alias launch keeps. Not in Start. -->
    <Application Id="Docker" Executable="bin\docker.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="FreeHarbor docker"
        Description="The docker command, forwarded to FreeHarbor's Docker CLI."
        BackgroundColor="transparent"
        AppListEntry="none"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="docker.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
