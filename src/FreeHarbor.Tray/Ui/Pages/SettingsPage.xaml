<!-- What the user prefers (DD301). A destination and not a dialog, for About's reason (L2): a choice
     made once is read and changed while looking at the window, not behind a modal. Today it holds
     one preference, where edits to names, descriptions and icons are saved, then the projects that
     depart from it and the order details are read in, so the choice can be predicted. -->
<UserControl x:Class="FreeHarbor.Tray.Ui.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="10,10,10,20" MaxWidth="720" HorizontalAlignment="Left">

      <TextBlock Text="Where edits to names, descriptions and icons are saved" FontSize="16"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <TextBlock Margin="0,4,0,12" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="The edit dialog opens on this. A project you save somewhere else keeps its own choice, listed below." />

      <RadioButton x:Name="ToFreeHarbor" GroupName="SaveTo" Tag="FreeHarbor" Checked="DefaultChosen">
        <StackPanel>
          <TextBlock Text="In FreeHarbor" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="Personal, on this machine only. The project folder is never touched." />
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="ToProjectFile" GroupName="SaveTo" Tag="ProjectFile" Checked="DefaultChosen"
                   Margin="0,8,0,0">
        <StackPanel>
          <TextBlock Text="In a .freeharbor folder in the project" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="Its own file beside the compose file, which it overrides, and shared with the team through git." />
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="ToComposeFile" GroupName="SaveTo" Tag="ComposeFile" Checked="DefaultChosen"
                   Margin="0,8,0,0">
        <StackPanel>
          <TextBlock Text="In the compose file" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="Only its x-freeharbor block is written, and the first save in each project shows the change before making it." />
        </StackPanel>
      </RadioButton>
      <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                 Text="Containers started without compose always save in FreeHarbor: they have no project folder to save in." />

      <TextBlock Text="Projects saved somewhere else" FontSize="12" FontWeight="SemiBold" Margin="0,24,0,8"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="NoOverrides" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                 Text="None. Every project follows the choice above." />
      <ItemsControl x:Name="Overrides">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Follow the default" Tag="{Binding Key}" Click="FollowDefault"
                      Style="{DynamicResource RowAction}" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Value}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Which value wins" FontSize="12" FontWeight="SemiBold" Margin="0,24,0,8"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="Each field is read from the first of these that sets it:" />
      <ItemsControl x:Name="ReadOrder">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontSize="12" Margin="0,0,0,2"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
