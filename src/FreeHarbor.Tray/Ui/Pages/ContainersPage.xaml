<!-- The containers list, which is what the window is opened for. Its header, its rows, its four
     verbs and its two empty states, and nothing about the engine banner or the strip above it: the
     shell owns the chrome and a list owns its page (DD35).

     The styles it draws with stay in MainWindow.Resources and are reached with DynamicResource, not
     StaticResource. That is not a preference: a StaticResource is resolved while this control is
     parsed, when it is not yet in the window's tree, and the Fluent Button these are BasedOn lives in
     the WINDOW's resources because ThemeMode puts it there (DD34). -->
<UserControl x:Class="FreeHarbor.Tray.Ui.Pages.ContainersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FreeHarbor.Tray.Ui"
             x:ClassModifier="internal">

    <UserControl.Resources>
        <!-- These two live here rather than in the shell, and BasedOn is why: it is a CLR property,
             not a DependencyProperty, so a DynamicResource on it is illegal — and WPF says so at
             RENDER time, on the first row measured, not at parse time. Moving them to the page that
             uses them makes a StaticResource correct again, because they are resolved inside the
             file that declares them.

             Neither is BasedOn the Fluent Button, so neither has the problem that keeps RowAction in
             the window (DD34). -->
        <!-- DD297: a tinted chip rather than bare accent text, so a link reads as a thing to press
             and not as a sentence that happens to be blue. -->
        <Style x:Key="PortLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- DD325: on the accent, tinted, as spec section 1's link chip is. The tint is the
                         accent at low opacity under the text rather than a colour of its own, so it
                         follows the system accent and both themes with no new token. -->
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hit" Background="{TemplateBinding Background}"
                                    CornerRadius="4" Opacity="0.18" />
                            <TextBlock Text="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DD297: a port that does not speak HTTP. Dashed, so it does not read as a link, and a
             click copies its address for the client that does speak it. A Border cannot dash, so
             the outline is a Rectangle under the text. -->
        <Style x:Key="PortCopy" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Hit" RadiusX="4" RadiusY="4" StrokeThickness="1"
                                       StrokeDashArray="3 2" Fill="{TemplateBinding Background}"
                                       Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <TextBlock Margin="{TemplateBinding Padding}"
                                       Foreground="{TemplateBinding Foreground}"><Run
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /> <Run
                                       Text="⧉" /></TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Fill"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DD326: a state chip over the list, as a pill. Not BasedOn the Fluent Button, so a
             StaticResource is correct here (see the note at the top). The chosen one is the accent
             tint and stroke the link chips use, so "this one is in force" reads the same way twice. -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hit" CornerRadius="13" Background="{TemplateBinding Background}" />
                            <Border CornerRadius="13" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="12,4">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillChosen" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="13" Opacity="0.25"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Border CornerRadius="13" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="12,4">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DD326: one half of the Cards/List switch, which is one segmented control: the halves sit
             inside one outline and the chosen one is filled. -->
        <Style x:Key="Segment" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" CornerRadius="4" Padding="12,3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentChosen" TargetType="Button" BasedOn="{StaticResource Segment}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>

        <!-- The ⋯ menu, one per button that shows it (x:Shared), and one definition so the list's row
             and a project card cannot offer different things (DD326). OpenOverflow hands it the
             button's Tag as its DataContext. -->
        <ContextMenu x:Key="RowOverflow" x:Shared="False">
            <!-- DD299. First, because it is the one item that only reads: the page that says what
                 this project serves and why a service stopped. -->
            <MenuItem Header="Details" Click="ShowDetails" Tag="{Binding}" />
            <Separator />
            <!-- Disabled rather than absent, because "you cannot do this yet" and "this does not
                 exist" are different answers and only the tooltip tells them apart. It has more room
                 here than on a cramped button. -->
            <MenuItem Header="Shell" Click="OpenShell" Tag="{Binding}"
                      IsEnabled="{Binding CanShell}"
                      ToolTip="{Binding ShellReason}" />
            <MenuItem Header="Restart" Click="RestartContainer" Tag="{Binding}"
                      IsEnabled="{Binding CanRestart}" />
            <!-- DD296. Enabled in every state: what a container is called does not depend on whether
                 it is running. -->
            <MenuItem Header="Edit details…" Click="EditDetails" Tag="{Binding}" />
            <Separator />
            <MenuItem Header="Remove…" Click="RemoveContainer" Tag="{Binding}"
                      IsEnabled="{Binding CanRemove}" />
        </ContextMenu>

        <!-- DD326: a card's Open, which writes where it goes after its name. -->
        <DataTemplate x:Key="OpenWithHost">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OpenLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="{Binding OpenHost}" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
            </StackPanel>
        </DataTemplate>

        <!-- DD326: a card's other links, outlined, each with the glyph, its name and where it goes. -->
        <DataTemplate x:Key="CardLink">
            <Button Tag="{Binding Url}" Click="OpenPort" ToolTip="{Binding Url}"
                    Margin="0,0,6,6" Padding="10,3" FontSize="12" MinWidth="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Address}" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- DD326: a card's address that only copies: the service, then the port in mono, dashed. -->
        <DataTemplate x:Key="CardCopy">
            <Button Tag="{Binding CopyText}" Click="CopyAddress" ToolTip="{Binding CopyText}"
                    Margin="0,0,6,6" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Hit" RadiusX="4" RadiusY="4" StrokeThickness="1"
                                       StrokeDashArray="3 2" Fill="Transparent"
                                       Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="8,3">
                                <TextBlock Text="⧉" Margin="0,0,6,0" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Service}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Label}" Margin="6,0,0,0" FontSize="12"
                                           FontFamily="{x:Static ui:Palette.Mono}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Fill"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- DD325: what every Open button holds, the external-link glyph and the link's name, so the
             list, the cards and the detail page cannot draw it three ways. -->
        <DataTemplate x:Key="OpenContent">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- DD298, DD300: one endpoint as a chip, a link to open or an address to copy. Shared by a
             card's links and a large project's pinned ones, so the two cannot draw it differently. -->
        <DataTemplate x:Key="EndpointChip">
            <Grid Margin="0,0,0,6">
                <Button Content="{Binding Label}" Tag="{Binding Url}" Click="OpenPort"
                        ToolTip="{Binding Url}" Style="{StaticResource PortLink}"
                        Visibility="{Binding CanOpen, Converter={StaticResource Shown}}" />
                <Button Content="{Binding Label}" Tag="{Binding CopyText}" Click="CopyAddress"
                        ToolTip="{Binding CopyText}" Style="{StaticResource PortCopy}"
                        Visibility="{Binding CopiesOnly, Converter={StaticResource Shown}}" />
            </Grid>
        </DataTemplate>

        <!-- DD299: one entry in the detail page's rail. The tile at the rail's 24 px, the title, and
             the state's shape on the right; the whole entry is the click. -->
        <DataTemplate x:Key="RailItem">
            <Button Tag="{Binding}" Click="ShowDetails" Cursor="Hand" Margin="0,0,0,2"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent">
                <Button.Template>
                    <!-- DD328: the item the page is open on carries the card's fill and stroke. -->
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="6,4" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRailSelected}" Value="True">
                                <Setter TargetName="Hit" Property="Background"
                                        Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter TargetName="Hit" Property="BorderBrush"
                                        Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="6" Margin="0,0,8,0"
                            VerticalAlignment="Center" Background="{Binding TileFill}">
                        <Grid>
                            <TextBlock Text="{Binding TileGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{x:Static ui:Palette.TileInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TileLetter}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{x:Static ui:Palette.TileInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding TilePicture}" Width="16" Height="16" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <!-- DD328: the shape in its state's colour, and under the title the count or status. -->
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ChipShape}" FontSize="11"
                               VerticalAlignment="Center" ToolTip="{Binding ChipEvidence}"
                               Foreground="{Binding ToneInk}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding RailNote}" TextTrimming="CharacterEllipsis" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>

        <!-- DD297: a link inside a sentence, which is what "Add icon and description" is. -->
        <Style x:Key="TextLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Words" Text="{TemplateBinding Content}" Background="Transparent"
                                   Foreground="{TemplateBinding Foreground}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Words" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,2,6,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </UserControl.Resources>
<Grid Margin="0,10,0,0">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" /><!-- the filter -->
    <RowDefinition Height="Auto" /><!-- the headings -->
    <RowDefinition Height="*" />   <!-- the rows -->
  </Grid.RowDefinitions>

  <!-- One box, over the rows already in hand. Never a second call to the daemon: every field it
       matches is on the row, and asking the engine to search would be a round trip to answer a
       question this window can answer itself. -->
  <!-- DD300: the Cards and List switch sits beside the box, and both views draw the same rows
       through the same filter and sort, so switching keeps what was narrowed. -->
  <!-- DD300: what the machine holds, counted over every container and not over the chip's narrowing,
       so the line says what is there while the chips say what is shown. -->
  <!-- DD320: the counts and the chips on the left, the switch and the box on the right. As one
       right-aligned row the four together were wider than the window's default width, and the
       filter box was the half cut off. -->
  <!-- DD326: two lines, the page's name and what it holds, then the pills under them. One line held
       the title, the counts and four pills, and at the default width it ran under the switch, which
       is the overlap DD320 removed. -->
  <StackPanel Grid.Row="0" x:Name="Summary" HorizontalAlignment="Left" Margin="10,0,10,10">
  <StackPanel Orientation="Horizontal">
    <!-- DD326: the page's name before what it holds, as the board heads it. -->
    <TextBlock Text="Containers" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="20"
               FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
    <TextBlock x:Name="Counts" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
  </StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
    <!-- The state chips as pills (DD326), each its word then its count in tertiary text; the one in
         force carries the accent. -->
    <Button x:Name="ChipAll" Tag="All" Click="ChooseChip" Margin="0,0,4,0"
            VerticalAlignment="Center" FontSize="12" Padding="10,3" MinWidth="0" />
    <Button x:Name="ChipRunning" Tag="Running" Click="ChooseChip" Margin="0,0,4,0"
            VerticalAlignment="Center" FontSize="12" Padding="10,3" MinWidth="0" />
    <Button x:Name="ChipStopped" Tag="Stopped" Click="ChooseChip" Margin="0,0,4,0"
            VerticalAlignment="Center" FontSize="12" Padding="10,3" MinWidth="0" />
    <Button x:Name="ChipProblems" Tag="Problems" Click="ChooseChip"
            VerticalAlignment="Center" FontSize="12" Padding="10,3" MinWidth="0" />
  </StackPanel>
  </StackPanel>
  <StackPanel Grid.Row="0" x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right"
              VerticalAlignment="Top" Margin="10,0,10,10">
    <!-- The switch before the box and not after it: the box keeps the right edge it always held,
         and a capture showed a button placed past it clipped by the page's edge. -->
    <!-- DD326: one segmented control, both halves in one outline, the chosen half filled. -->
    <Border Margin="0,0,10,0" Padding="2" CornerRadius="6" BorderThickness="1" VerticalAlignment="Center"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="CardsSwitch" Content="Cards" Click="ChooseCards"
                Style="{StaticResource Segment}" ToolTip="One card per project" />
        <Button x:Name="ListSwitch" Content="List" Click="ChooseList"
                Style="{StaticResource Segment}" ToolTip="One row per container" />
      </StackPanel>
    </Border>
    <TextBox x:Name="Filter" Style="{DynamicResource FilterBox}"
             TextChanged="FilterChanged"
             ToolTip="Narrow by name, image, state or port" />
  </StackPanel>

        <Grid Grid.Row="1" x:Name="HeaderRow" Margin="10,0,10,6">
<Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.2*" />
    <ColumnDefinition Width="1.3*" />
    <ColumnDefinition Width="0.7*" />
    <ColumnDefinition Width="1.1*" />
    <ColumnDefinition Width="1.2*" />
    <ColumnDefinition Width="180" />
</Grid.ColumnDefinitions>
<Button Grid.Column="0" Tag="NAME" Click="SortBy"
        Style="{DynamicResource SortHeading}"
        Content="NAME" x:Name="NameHeading" />
<Button Grid.Column="1" Tag="IMAGE" Click="SortBy"
        Style="{DynamicResource SortHeading}"
        Content="IMAGE" x:Name="ImageHeading" />
<Button Grid.Column="2" Tag="STATE" Click="SortBy"
        Style="{DynamicResource SortHeading}"
        Content="STATE" x:Name="StateHeading" />
<Button Grid.Column="3" Tag="STATUS" Click="SortBy"
        Style="{DynamicResource SortHeading}"
        Content="STATUS" x:Name="StatusHeading" />
<Button Grid.Column="4" Tag="PORTS" Click="SortBy"
        Style="{DynamicResource SortHeading}"
        Content="PORTS" x:Name="PortsHeading" />
        </Grid>

        <ListView Grid.Row="2" x:Name="Containers" BorderThickness="0"
      Background="Transparent"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListView.ItemContainerStyle>
    <!-- DD324. No item chrome of its own: a project is one card drawn across its rows, and the Fluent
         item's margin and rounded highlight would cut that card into strips. The row's own border
         below is the card, and it carries the hover. Nothing reads the list's selection. -->
    <Style TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ListView.ItemContainerStyle>
<ListView.ItemTemplate>
    <DataTemplate>
      <!-- DD324. The group card (DD34 section 3: card fill, card stroke, 8 px radius), drawn a row at a
           time: the first row of a card has its top corners, the last its bottom ones and the gap
           under it, and every row's top edge is the hairline between it and the one above. A row
           outside any card is the plain list it always was. -->
      <Border Margin="{Binding CardGap}" CornerRadius="{Binding CardCorners}"
              BorderThickness="{Binding CardEdges}" Padding="10,8"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding InCard}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
      <StackPanel>
        <!-- DD297, DD324. The Standalone containers block's header strip, drawn above the first
             container started without compose: a tile, the heading, its count and one line of what
             the block is. On that row and not a row of its own, because a heading has no columns
             and no verbs, and a third kind of row is what DD111's member sets would have to answer
             for. The rule under it reaches the card's edges through the row's padding. -->
        <Border Margin="-10,-8,-10,8" Padding="10,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding StartsStandalone, Converter={StaticResource Shown}}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10"
                        Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"><Run
                               Text="Standalone containers" FontWeight="SemiBold" />  <Run
                               Text="{Binding StandaloneCount, Mode=OneWay}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                    <TextBlock Text="Started with docker run, outside any compose project. Each row is its own unit."
                               FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Character for character the same as HeaderRow's, and a test asserts
                     it: a header whose columns have drifted from the rows under it puts
                     every caption over the wrong cell, and nothing but looking at the
                     window says so. -->
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="0.7*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <!-- DD106. The indent is on this cell rather than on the whole row: pushing the grid in
                 would take every other column with it, and a STATE cell that no longer sits under
                 the STATE caption is the one thing L3 is about. A DockPanel rather than a nested
                 Grid — nesting one would add a third ColumnDefinitions block to this file and the
                 guard that pairs a header with its rows counts them. -->
            <!-- DD324. On a header the cell spans NAME to STATUS, so its description runs under the
                 title to where Open is: a header has no image or status of its own to share the row
                 with. Everything on a header sits at the top, so the chip in STATE stays beside the
                 title and clear of the description under it. -->
            <DockPanel Grid.Column="0" Grid.ColumnSpan="{Binding NameSpan}" Margin="{Binding Indent}"
                       LastChildFill="True" Panel.ZIndex="1">
                <!-- The affordance: a row that opens into containers and one that does not must not
                     look the same. The glyph pair and the font are claude-tray's, because that
                     window is this project's reference and a second vocabulary reads as a second
                     application. -->
                <TextBlock DockPanel.Dock="Left" Text="{Binding Chevron}" IsHitTestVisible="False"
                           FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="0,5,8,0"
                           VerticalAlignment="{Binding TitleAlignment}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding IsProject, Converter={StaticResource Shown}}" />
                <!-- DD294. The icon tile: a glyph for what the image is, a picture from disk, or the
                     title's first letter, white on the hue hashed from the name. Opaque where the
                     chips are tints, because white on a tint vanishes on the light theme. 40 px is
                     the spec's size for the list (docs/specs/DD294-containers-redesign.md, §1). -->
                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10"
                        Margin="0,0,10,0" VerticalAlignment="{Binding TitleAlignment}" IsHitTestVisible="False"
                        Background="{Binding TileFill}"
                        Visibility="{Binding HasTile, Converter={StaticResource Shown}}">
                    <Grid>
                        <TextBlock Text="{Binding TileGlyph}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="18" Foreground="{x:Static ui:Palette.TileInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TileLetter}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{x:Static ui:Palette.TileInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding TilePicture}" Width="26" Height="26"
                               Stretch="Uniform" />
                    </Grid>
                </Border>
                <!-- The title over what it is for. The container's own name, which the title
                     replaced, is the tooltip, so nothing the daemon calls it is lost. -->
                <!-- The right margin is the gutter to IMAGE: without it a trimmed description's
                     ellipsis ran straight into the image name. On the cell's content and not on
                     the image, so the IMAGE header still lines up with its column. -->
                <DockPanel VerticalAlignment="{Binding TitleAlignment}" LastChildFill="True"
                           Margin="0,0,16,0">
                <!-- DD324. A service inside a project leads with its state's shape, in its chip's
                     colour: the tile belongs to the header above it. Beside the title and not
                     centred on the block, or under a description it reads as that line's bullet.
                     It never shares a row with the tile (HasTile excludes it), so it can live in
                     the title's own panel. -->
                <TextBlock DockPanel.Dock="Left" Text="{Binding ChipShape}" IsHitTestVisible="False"
                           FontSize="14" Width="14" Margin="0,0,12,0" VerticalAlignment="Top"
                           Foreground="{Binding ShapeInk}"
                           Visibility="{Binding HasStateShape, Converter={StaticResource Shown}}" />
                <StackPanel ToolTip="{Binding NameEvidence}">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               IsHitTestVisible="{Binding IsContainer}"
                               Visibility="{Binding TitleIsText, Converter={StaticResource Shown}}" />
                    <!-- DD299. A header's or a standalone container's title opens its detail page.
                         Above the fold's hit target (the cell's ZIndex), so the title takes its own
                         click and the rest of the strip still folds (DD127). -->
                    <Button Content="{Binding Title}" Tag="{Binding}" Click="ShowDetails"
                            HorizontalAlignment="Left" FontSize="14"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Style="{StaticResource TextLink}"
                            Visibility="{Binding OpensDetail, Converter={StaticResource Shown}}" />
                    <TextBlock Text="{Binding DescriptionLine}" TextTrimming="CharacterEllipsis"
                               FontSize="12" IsHitTestVisible="{Binding IsContainer}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasDescription, Converter={StaticResource Shown}}" />
                    <!-- DD297. A standalone container has no project file to be described in, so
                         where it has no description it says so and offers the edit dialog. -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding InvitesDetails, Converter={StaticResource Shown}}">
                        <TextBlock Text="No details yet · " FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Button Content="Add icon and description" Tag="{Binding}" Click="EditDetails"
                                Style="{StaticResource TextLink}" />
                    </StackPanel>
                </StackPanel>
                </DockPanel>
            </DockPanel>
            <!-- DD167. A second Run rather than a second element: the note has to sit against the
                 image it is about, and anything laid out across the cell puts it at the far edge
                 where it reads as belonging to the STATE chip next door — seen by capturing it.
                 A Run also needs no panel, so this cell stays one TextBlock and the file keeps the
                 single ColumnDefinitions block the header-and-rows guard pairs.

                 Tertiary and in no warning colour: an image rebuilt under a running container is a
                 condition and not a failure, and Danger is spoken for by the line the daemon's own
                 refusals land on. Empty on every other row, so it costs nothing to draw. The
                 tooltip carries what to do, because the reflex this provokes — restart it — is the
                 one thing that does not work. -->
            <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsContainer, Converter={StaticResource Shown}}"><Run
                       Text="{Binding Image, Mode=OneWay}" /> <Run
                       Text="{Binding ImageNote, Mode=OneWay}" FontSize="11"
                       ToolTip="{Binding ImageEvidence}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" /></TextBlock>
            <!-- A chip, because state is the column actually scanned and it used to be drawn in
                 the same tertiary grey as the status restating it. The fill is translucent so one
                 pair of bytes works on both surfaces, and it is resolved once per render rather
                 than per row (Ui/RowStyle.cs). A chip is an assertion, so it carries the evidence
                 for itself in its tooltip — and the evidence is more than the status column already
                 shows, or the tooltip would be the same sentence twice. -->
            <!-- DD297. A header carries the chip too: its project's count, in the tone of what is
                 under it. Of the containers under it and not of the project as the daemon knows it:
                 the filter can hide some, and a count a reader cannot check against what is on screen
                 is worse than none. In the list the chip is the word alone: a service already leads
                 with the shape beside its title, and a dot inside the chip as well only cluttered it. -->
            <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="{Binding TitleAlignment}"
                    CornerRadius="5" Padding="8,2" Background="{Binding ChipFill}"
                    ToolTip="{Binding ChipEvidence}">
                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                           Text="{Binding ChipWord}" Foreground="{Binding ChipText}" />
            </Border>
            <TextBlock Grid.Column="3" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsContainer, Converter={StaticResource Shown}}" />
            <!-- DD297. The Open button, on a header and on a container outside compose, then the port
                 chips. Open is disabled rather than hidden while nothing is running, so the place it
                 sits does not move when a project stops. -->
            <WrapPanel Grid.Column="4" VerticalAlignment="{Binding TitleAlignment}">
                <Button Content="{Binding OpenLabel}" ContentTemplate="{StaticResource OpenContent}" Tag="{Binding OpenLink.Url}" Click="OpenPort"
                        ToolTip="{Binding OpenLink.Url}" IsEnabled="{Binding CanOpen}"
                        Style="{DynamicResource AccentButtonStyle}" FontSize="12" Padding="10,3"
                        Margin="0,0,6,0" MinWidth="0"
                        Visibility="{Binding ShowsOpen, Converter={StaticResource Shown}}" />
                <!-- DD298: a large project's pinned links and the menu holding every link. -->
                <ItemsControl ItemsSource="{Binding PinnedLinks}" ItemTemplate="{StaticResource EndpointChip}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Content="{Binding LinkMenuLabel}" Tag="{Binding}" Click="OpenLinkMenu"
                        Style="{DynamicResource RowAction}" ToolTip="Every link"
                        Visibility="{Binding HasLinkMenu, Converter={StaticResource Shown}}" />
            <!-- DD325: a stopped container's chips are dimmed, not hidden, so the place they sit does
                 not move and what it would serve is still read. -->
            <ItemsControl ItemsSource="{Binding PortChips}" VerticalAlignment="Center">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- One of the three shows: a tinted chip that opens a browser, a dashed one
                             that copies the address of a port that does not speak HTTP, or plain
                             text for a port only exposed. Each is its own flag on the port, so a
                             trigger per element and no converter. -->
                        <Grid>
                            <Button Content="{Binding Text}" Tag="{Binding Url}"
                                    Click="OpenPort" ToolTip="{Binding LinkHint}"
                                    Style="{StaticResource PortLink}" FontFamily="{x:Static ui:Palette.Mono}"
                                    Visibility="{Binding IsLink, Converter={StaticResource Shown}}" />
                            <Button Content="{Binding Text}" Tag="{Binding Address}"
                                    Click="CopyAddress" ToolTip="{Binding CopyHint}"
                                    Style="{StaticResource PortCopy}" FontFamily="{x:Static ui:Palette.Mono}"
                                    Visibility="{Binding IsCopy, Converter={StaticResource Shown}}" />
                            <TextBlock Text="{Binding Text}" Style="{StaticResource PortText}"
                                       Visibility="{Binding IsText, Converter={StaticResource Shown}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </WrapPanel>

            <!-- The four verbs, or the one word that says the click landed. Optimistic:
                 the row goes pending on press and the event stream is what takes it
                 back out, because a stop can take the daemon's full ten seconds. -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="{Binding TitleAlignment}">
                <!-- First, and offered in every state including pending: the log is the
                     one artefact a container that exited two seconds in leaves, and
                     reading it changes nothing that could be in flight. -->
                <Button Content="Logs" Tag="{Binding}" Click="OpenLogs"
                        Style="{DynamicResource RowAction}"
                        Visibility="{Binding LogsVisibility}" />
                <!-- The one verb this row is opened for: a running container to be stopped, a
                     stopped one to be started. The other three are one click deeper. -->
                <Button Content="{Binding PrimaryVerb}" Tag="{Binding}" Click="PrimaryAction"
                        Style="{DynamicResource RowAction}"
                        Visibility="{Binding HasPrimary, Converter={StaticResource Shown}}" />
                <!-- Always drawn, never revealed on hover: the section is explicit that hiding a
                     verb costs a discovery problem, and a button nobody can see is a verb nobody
                     finds. One click deeper is not the same as hidden. -->
                <Button Content="⋯" Click="OpenOverflow" Tag="{Binding}"
                        Style="{DynamicResource RowAction}"
                        ToolTip="Shell, restart, edit details and remove"
                        ContextMenu="{StaticResource RowOverflow}"
                        Visibility="{Binding CanRemove, Converter={StaticResource Shown}}" />
                <TextBlock Text="{Binding Pending}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding IsPending, Converter={StaticResource Shown}}" />
            </StackPanel>

            <!-- The header's hit target, and the last child of the grid so it sits over the cells it
                 covers. Collapsed on a container, which is the trigger — so it catches nothing on a
                 row that has its own buttons. The whole strip rather than the chevron alone: a
                 nine-pixel glyph is a target somebody has to aim at, and the row already reads as
                 one thing. Verbs on a project are DD107; this only folds it away.

                 Both alignments are stated, and they are the whole of DD127: the Fluent Button style
                 sets Left and Center, a templated Border with no child measures to nothing, and a
                 hit target arranged at 0x0 catches no click at all — so the header looked like it
                 folded and never did. Stated locally because a local value is what beats a style.

                 Four columns and not five since DD297: the PORTS cell holds the header's Open, and a
                 hit target laid over it would fold the project instead of opening it. -->
            <Button Grid.Column="0" Grid.ColumnSpan="4" Tag="{Binding}" Click="ToggleProject"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="Show or hide this project's containers"
                    Visibility="{Binding IsProject, Converter={StaticResource Shown}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Where the click was, in the engine's own words. A port already in use or a
             volume still mounted is an ordinary answer, and the daemon says it better
             than any paraphrase this tool could write. -->
        <TextBlock Text="{Binding Failure}" Margin="0,4,0,0" TextWrapping="Wrap"
                   FontSize="12" Foreground="{x:Static ui:Palette.DangerBrush}"
                   Visibility="{Binding HasFailure, Converter={StaticResource Shown}}" />
      </StackPanel>
      </Border>
    </DataTemplate>
</ListView.ItemTemplate>
        </ListView>

        <!-- Empty is designed, not a blank grid: the two reasons a list is empty read differently,
 and only one of them is something the user can do anything about. -->
        <StackPanel Grid.Row="2" x:Name="Empty" VerticalAlignment="Center"
        HorizontalAlignment="Center" Visibility="Collapsed">
<TextBlock x:Name="EmptyHeadline" FontSize="20" HorizontalAlignment="Center"
           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
<TextBlock x:Name="EmptyDetail" Margin="0,8,0,0" FontSize="13"
           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
           TextWrapping="Wrap"
           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
<Button x:Name="EmptyStart" Content="Start the engine" Margin="0,18,0,0"
        Padding="18,8" HorizontalAlignment="Center" Visibility="Collapsed"
        Click="StartEngine" />
        </StackPanel>

  <!-- DD299. The detail page, laid over the list rather than replacing it: the list stays built and
       collapsed underneath, so Back finds it at the scroll position it was left at. Its DataContext
       is a DetailView, rebuilt from the rows in hand on every redraw like the list itself. -->
  <!-- DD300. The cards view: one card per project, then the standalone containers as one-line cards.
       Filled from code with the same rows the list draws, through DetailView.Cards. -->
  <ScrollViewer Grid.Row="1" Grid.RowSpan="2" x:Name="CardsPane" Visibility="Collapsed"
                VerticalScrollBarVisibility="Auto" Padding="10,0,10,10"
                SizeChanged="CardsPaneSized">
    <StackPanel>
      <ItemsControl x:Name="ProjectCards">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         VerticalAlignment="Top" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- A click on the card outside its buttons opens the project's page; a button marks its
                 own click handled, so it never reaches here. -->
            <Border Margin="0,0,12,12" Padding="16,14" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Tag="{Binding}" MouseLeftButtonUp="CardClicked" Cursor="Hand">
              <StackPanel>
                <DockPanel>
                  <!-- DD326: the header's ⋯, the list header's menu, at the top right. -->
                  <Button DockPanel.Dock="Right" Content="⋯" Click="OpenOverflow" Tag="{Binding Head}"
                          Style="{DynamicResource RowAction}" VerticalAlignment="Top"
                          ToolTip="Details, shell, restart, edit details and remove"
                          ContextMenu="{StaticResource RowOverflow}" />
                  <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="11" Margin="0,0,12,0"
                          VerticalAlignment="Top" Background="{Binding Head.TileFill}">
                    <Grid>
                      <TextBlock Text="{Binding Head.TileGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                 Foreground="{x:Static ui:Palette.TileInk}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Head.TileLetter}" FontSize="18" FontWeight="SemiBold"
                                 Foreground="{x:Static ui:Palette.TileInk}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding Head.TilePicture}" Width="28" Height="28" Stretch="Uniform" />
                    </Grid>
                  </Border>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="{Binding Head.Title}" Tag="{Binding Head}" Click="ShowDetails"
                              FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              Style="{StaticResource TextLink}" VerticalAlignment="Center" />
                      <Border Margin="10,0,0,0" CornerRadius="5" Padding="8,2" VerticalAlignment="Center"
                              Background="{Binding Head.ChipFill}" ToolTip="{Binding Head.ChipEvidence}">
                        <TextBlock FontSize="12" Foreground="{Binding Head.ChipText}"
                                   Text="{Binding Head.ChipWord}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Head.DescriptionLine}" FontSize="12" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding Head.HasDescription, Converter={StaticResource Shown}}" />
                    <!-- DD326: what kind of thing, which one and how big, in tertiary text. -->
                    <TextBlock Text="{Binding CardMeta}" FontSize="12" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                </DockPanel>

                <!-- DD337: one line per kind of failure, in plain words; the exit codes are in the
                     tooltip and on the project's page. -->
                <ItemsControl ItemsSource="{Binding CardAlerts}" Margin="0,10,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"
                                 ToolTip="{Binding Evidence}"
                                 Foreground="{x:Static ui:Palette.DangerBrush}"><Run Text="●" FontSize="10" /> <Run
                                 Text="{Binding Sentence, Mode=OneWay}" /></TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The links: Open filled in the accent, the rest as the list's chips. A stopped
                     project dims these and never the card, so its Start stays readable. -->
                <!-- DD326: Open with where it goes, the other links outlined beside it, and on the
                     next line the addresses that only copy, each named by its service. -->
                <StackPanel Margin="0,12,0,0">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Head.AnyUp}" Value="False">
                          <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <WrapPanel>
                    <Button Content="{Binding Head}" ContentTemplate="{StaticResource OpenWithHost}"
                            Tag="{Binding Head.OpenLink.Url}" Click="OpenPort"
                            ToolTip="{Binding Head.OpenLink.Url}" IsEnabled="{Binding Head.CanOpen}"
                            Style="{DynamicResource AccentButtonStyle}" FontSize="12" Padding="10,3"
                            Margin="0,0,6,6" MinWidth="0"
                            Visibility="{Binding Head.ShowsOpen, Converter={StaticResource Shown}}" />
                    <ItemsControl ItemsSource="{Binding CardOpenLinks}" ItemTemplate="{StaticResource CardLink}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- DD298: past three links, the rest are behind this menu. -->
                    <Button Content="{Binding Head.LinkMenuLabel}" Tag="{Binding Head}" Click="OpenLinkMenu"
                            Style="{DynamicResource RowAction}" Margin="0,0,6,6" ToolTip="Every link"
                            Visibility="{Binding Head.HasLinkMenu, Converter={StaticResource Shown}}" />
                  </WrapPanel>
                  <ItemsControl ItemsSource="{Binding CardCopyLinks}" ItemTemplate="{StaticResource CardCopy}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </StackPanel>

                <!-- DD326: the services under a rule. -->
                <Border Margin="0,6,0,0" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />

                <!-- DD326: one row per service: its state's shape and colour, its title and image,
                     and at the right its port in mono and its state word in that same colour. -->
                <ItemsControl ItemsSource="{Binding CardServices}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,3,0,3" ToolTip="{Binding ChipEvidence}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ChipShape}" FontSize="12" Width="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{Binding ShapeInk}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StateWord}" FontSize="12" MinWidth="56"
                                   TextAlignment="Right"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding ShapeInk}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FirstPort}" FontSize="12"
                                   FontFamily="{x:Static ui:Palette.Mono}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><Run
                                   Text="{Binding Title, Mode=OneWay}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />  <Run
                                   Text="{Binding Image, Mode=OneWay}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" /></TextBlock>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- DD337: a card that left services out says so under them, in place of DD298's
                     row of shapes. -->
                <Button Content="{Binding ShowAllLabel}" Tag="{Binding}" Click="ShowAllServices"
                        Style="{StaticResource TextLink}" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Visibility="{Binding HasMoreServices, Converter={StaticResource Shown}}" />

                <!-- The one verb, which is the accent button only when it is Start (spec section 5,
                     fixed), because starting is what a stopped card is opened for. No Restart beside
                     it: DD36 keeps a row to its one verb, and the project's page is a click away.
                     DD326: the project's uptime on the left of the footer. -->
                <DockPanel Margin="0,12,0,0">
                <TextBlock Text="{Binding Uptime}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                  <TextBlock Text="{Binding Head.Pending}" VerticalAlignment="Center" Margin="0,0,8,0"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Visibility="{Binding Head.IsPending, Converter={StaticResource Shown}}" />
                  <Button Content="Stop" Tag="{Binding Head}" Click="PrimaryAction"
                          Style="{DynamicResource RowAction}"
                          Visibility="{Binding Head.CanStop, Converter={StaticResource Shown}}" />
                  <Button Content="Start" Tag="{Binding Head}" Click="PrimaryAction"
                          Style="{DynamicResource AccentButtonStyle}" FontSize="12" Padding="10,3"
                          MinWidth="0"
                          Visibility="{Binding Head.CanStart, Converter={StaticResource Shown}}" />
                </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- DD327: the heading carries what the block is beside it. -->
      <StackPanel x:Name="StandaloneHeading" Orientation="Horizontal" Margin="0,8,0,10">
        <TextBlock Text="Standalone containers" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Text="Started with docker run, outside any compose project" Margin="12,0,0,0"
                   FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <!-- DD327: a card each, in the project cards' grid and at their width, not a strip across the
           page. -->
      <ItemsControl x:Name="StandaloneCards">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         VerticalAlignment="Top" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,12,12" Padding="16,14" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="11" Margin="0,0,12,0"
                        VerticalAlignment="Center" Background="{Binding TileFill}">
                  <Grid>
                    <TextBlock Text="{Binding TileGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{x:Static ui:Palette.TileInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TileLetter}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{x:Static ui:Palette.TileInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding TilePicture}" Width="28" Height="28" Stretch="Uniform" />
                  </Grid>
                </Border>
                <!-- Open where it has a link, the one verb, and the list's ⋯ menu. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                  <Button Content="{Binding OpenLabel}" ContentTemplate="{StaticResource OpenContent}" Tag="{Binding OpenLink.Url}" Click="OpenPort"
                          ToolTip="{Binding OpenLink.Url}" IsEnabled="{Binding CanOpen}"
                          Style="{DynamicResource AccentButtonStyle}" FontSize="12" Padding="10,3"
                          Margin="0,0,6,0" MinWidth="0"
                          Visibility="{Binding ShowsOpen, Converter={StaticResource Shown}}" />
                  <Button Content="{Binding PrimaryVerb}" Tag="{Binding}" Click="PrimaryAction"
                          Style="{DynamicResource RowAction}"
                          Visibility="{Binding HasPrimary, Converter={StaticResource Shown}}" />
                  <TextBlock Text="{Binding Pending}" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Visibility="{Binding IsPending, Converter={StaticResource Shown}}" />
                  <Button Content="⋯" Click="OpenOverflow" Tag="{Binding}"
                          Style="{DynamicResource RowAction}"
                          ToolTip="Details, shell, restart, edit details and remove"
                          ContextMenu="{StaticResource RowOverflow}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding Title}" Tag="{Binding}" Click="ShowDetails"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="15"
                            Style="{StaticResource TextLink}" VerticalAlignment="Center" />
                    <Border Margin="10,0,0,0" CornerRadius="5" Padding="8,2" VerticalAlignment="Center"
                            Background="{Binding ChipFill}" ToolTip="{Binding ChipEvidence}">
                      <TextBlock FontSize="12" Foreground="{Binding ChipText}"
                                 Text="{Binding ChipWord}" />
                    </Border>
                  </StackPanel>
                  <!-- Two lines at most: a description longer than that belongs to the page. -->
                  <TextBlock Text="{Binding DescriptionLine}" FontSize="12" Margin="0,2,0,0"
                             TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Visibility="{Binding HasDescription, Converter={StaticResource Shown}}" />
                  <StackPanel Orientation="Horizontal"
                              Visibility="{Binding InvitesDetails, Converter={StaticResource Shown}}">
                    <TextBlock Text="No details yet · " FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Button Content="Add icon and description" Tag="{Binding}" Click="EditDetails"
                            Style="{StaticResource TextLink}" />
                  </StackPanel>
                  <!-- DD327: the details line, image in mono, then the ports, then the uptime,
                       cut at the end where the card is narrow. -->
                  <TextBlock FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"><Run
                             Text="{Binding Image, Mode=OneWay}" FontFamily="{x:Static ui:Palette.Mono}" /> · <Run
                             Text="{Binding PortsLine, Mode=OneWay}" /> · <Run Text="{Binding Status, Mode=OneWay}" /></TextBlock>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>

  <!-- A DockPanel and not a two-column Grid: the guard that pairs a list's header with its rows
       counts this file's ColumnDefinitions blocks, and the detail page captions nothing. -->
  <DockPanel Grid.Row="0" Grid.RowSpan="3" x:Name="Detail" Visibility="Collapsed">

    <!-- The rail: compose projects, then standalone containers, so moving between pages does not go
         back through the list. Filled from code, from the rows in hand, on every redraw. -->
    <DockPanel DockPanel.Dock="Left" Width="230" Margin="10,0,10,10">
      <!-- DD328: the box says what it is for while it is empty, laid over it and never in it, so
           nothing has to be cleared before typing. -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
        <TextBox x:Name="RailFilter"
                 Style="{DynamicResource FilterBox}" HorizontalAlignment="Stretch" Width="Auto"
                 TextChanged="RailFilterChanged" ToolTip="Narrow the rail by name" />
        <TextBlock Text="Filter" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=RailFilter}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="COMPOSE PROJECTS" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <ItemsControl x:Name="RailProjects" ItemTemplate="{StaticResource RailItem}" />
          <TextBlock Text="STANDALONE" Margin="0,12,0,6" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <ItemsControl x:Name="RailStandalone" ItemTemplate="{StaticResource RailItem}" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
    <StackPanel>
      <Button Content="‹ Back" Click="CloseDetails" HorizontalAlignment="Left"
              Style="{DynamicResource RowAction}" Margin="0,0,0,14" />

      <DockPanel>
        <!-- The 64 px tile the spec gives the detail page (section 1). -->
        <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="16" Margin="0,0,16,0"
                VerticalAlignment="Top" Background="{Binding Head.TileFill}">
          <Grid>
            <TextBlock Text="{Binding Head.TileGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="28"
                       Foreground="{x:Static ui:Palette.TileInk}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Head.TileLetter}" FontSize="26" FontWeight="SemiBold"
                       Foreground="{x:Static ui:Palette.TileInk}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{Binding Head.TilePicture}" Width="40" Height="40" Stretch="Uniform" />
          </Grid>
        </Border>
        <!-- The verbs: Open, Restart, the one primary verb, and ⋯ (DD328), which holds Edit details as
             it does everywhere else. The same handlers and the same menu the list's header uses,
             addressed to the same row, so the two places cannot do different things. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="{Binding Head.OpenLabel}" ContentTemplate="{StaticResource OpenContent}" Tag="{Binding Head.OpenLink.Url}" Click="OpenPort"
                  ToolTip="{Binding Head.OpenLink.Url}" IsEnabled="{Binding Head.CanOpen}"
                  Style="{DynamicResource AccentButtonStyle}" FontSize="12" Padding="10,3"
                  Margin="0,0,6,0" MinWidth="0"
                  Visibility="{Binding Head.ShowsOpen, Converter={StaticResource Shown}}" />
          <Button Content="Restart" Tag="{Binding Head}" Click="RestartContainer"
                  Style="{DynamicResource RowAction}" IsEnabled="{Binding Head.CanRestart}" />
          <Button Content="{Binding Head.PrimaryVerb}" Tag="{Binding Head}" Click="PrimaryAction"
                  Style="{DynamicResource RowAction}"
                  Visibility="{Binding Head.HasPrimary, Converter={StaticResource Shown}}" />
          <Button Content="⋯" Click="OpenOverflow" Tag="{Binding Head}"
                  Style="{DynamicResource RowAction}"
                  ToolTip="Details, shell, restart, edit details and remove"
                  ContextMenu="{StaticResource RowOverflow}" />
          <TextBlock Text="{Binding Head.Pending}" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     Visibility="{Binding Head.IsPending, Converter={StaticResource Shown}}" />
        </StackPanel>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Head.Title}" FontSize="20" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <Border Margin="12,0,0,0" CornerRadius="5" Padding="8,2" VerticalAlignment="Center"
                    Background="{Binding Head.ChipFill}" ToolTip="{Binding Head.ChipEvidence}">
              <TextBlock FontSize="12" Foreground="{Binding Head.ChipText}"><Run
                         Text="{Binding Head.ChipShape, Mode=OneWay}" FontSize="10" /> <Run
                         Text="{Binding Head.ChipWord, Mode=OneWay}" /></TextBlock>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Head.Description}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Visibility="{Binding Head.HasDescription, Converter={StaticResource Shown}}" />
          <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
      </DockPanel>

      <!-- One banner per service that stopped and did not mean to (DD328): the service in bold, the
           daemon's own sentence, and the one verb that answers it inside the banner. Danger at low
           opacity under it and Danger as its stroke, so it reads as a failure on either theme with
           no colour of its own. -->
      <ItemsControl ItemsSource="{Binding Problems}" Margin="0,16,0,0"
                    Visibility="{Binding HasProblems, Converter={StaticResource Shown}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,8">
              <Border CornerRadius="6" Opacity="0.12" Background="{x:Static ui:Palette.DangerBrush}" />
              <Border CornerRadius="6" BorderThickness="1" Padding="12,8"
                      BorderBrush="{x:Static ui:Palette.DangerBrush}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{Binding StartLabel}" Tag="{Binding Row}"
                          Click="PrimaryAction" Style="{DynamicResource RowAction}"
                          Visibility="{Binding Row.CanStart, Converter={StaticResource Shown}}" />
                  <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"><Run Text="●" FontSize="11"
                             Foreground="{x:Static ui:Palette.DangerBrush}" />  <Run
                             Text="{Binding Row.Title, Mode=OneWay}" FontWeight="SemiBold" />: <Run
                             Text="{Binding Row.Status, Mode=OneWay}" /></TextBlock>
                </DockPanel>
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="ENDPOINTS" Margin="0,20,0,8" FontSize="12" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Visibility="{Binding HasEndpoints, Converter={StaticResource Shown}}" />
      <ItemsControl ItemsSource="{Binding Endpoints}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="220" Margin="0,0,10,10" Padding="12,10" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel>
                <!-- DD328: what it is and who serves it in secondary text, then the address itself in
                     accent mono, the URL where there is one, so what Copy takes is what is read. -->
                <TextBlock TextTrimming="CharacterEllipsis" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"><Run
                           Text="{Binding Label, Mode=OneWay}" /> · <Run
                           Text="{Binding Service, Mode=OneWay}" /></TextBlock>
                <TextBlock Text="{Binding CopyText}" Margin="0,4,0,8" FontSize="12"
                           FontFamily="{x:Static ui:Palette.Mono}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CopyText}"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="Open" ContentTemplate="{StaticResource OpenContent}" Tag="{Binding Url}"
                          Click="OpenPort" Style="{DynamicResource AccentButtonStyle}" FontSize="12"
                          Padding="10,3" Margin="0,0,6,0" MinWidth="0"
                          Visibility="{Binding CanOpen, Converter={StaticResource Shown}}" />
                  <Button Content="Copy" Tag="{Binding CopyText}" Click="CopyAddress"
                          Style="{DynamicResource RowAction}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- DD328: Services and Recent output side by side, so the failing service's lines are in
           view beside the list that says which one failed. A UniformGrid and not a Grid with
           columns: the guard that pairs the list's header with its rows counts this file's
           ColumnDefinitions blocks. -->
      <UniformGrid Columns="2" Margin="0,14,0,0">
      <StackPanel Margin="0,0,12,0">
      <TextBlock Text="SERVICES" Margin="0,0,0,8" FontSize="12" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <!-- One bordered list: each service's shape in its colour, its title over its image, its state
           word at the right in the same colour, and Logs. -->
      <Border CornerRadius="6" BorderThickness="1" Padding="12,4"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
      <ItemsControl ItemsSource="{Binding Services}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,6" ToolTip="{Binding ChipEvidence}">
              <TextBlock DockPanel.Dock="Left" Text="{Binding ChipShape}" Width="14" Margin="0,0,10,0"
                         FontSize="12" VerticalAlignment="Center" Foreground="{Binding ToneInk}" />
              <Button DockPanel.Dock="Right" Content="Logs" Tag="{Binding}" Click="OpenLogs"
                      Style="{DynamicResource RowAction}" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding StateWord}" Margin="12,0,10,0" FontSize="12"
                         MinWidth="56" TextAlignment="Right"
                         VerticalAlignment="Center" Foreground="{Binding ToneInk}" />
              <StackPanel VerticalAlignment="Center" ToolTip="{Binding NameEvidence}">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Image}" TextTrimming="CharacterEllipsis" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Border>
      </StackPanel>

      <StackPanel>
      <!-- The last lines of the failing service, or of the first one when none failed, read once
           when the page opens on it. Open log is the live, followed view of the same stream. -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock x:Name="OutputCaption" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Button x:Name="OutputOpenLog" Content="Open log" Click="OpenLogs" Margin="12,0,0,0"
                Style="{StaticResource TextLink}" VerticalAlignment="Center" />
      </StackPanel>
      <Border Padding="12,10" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <ItemsControl x:Name="Output">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                         FontFamily="Cascadia Mono, Consolas, Courier New">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsError}" Value="True">
                        <Setter Property="Foreground" Value="{x:Static ui:Palette.DangerBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      </StackPanel>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
  </DockPanel>
</Grid>
</UserControl>
