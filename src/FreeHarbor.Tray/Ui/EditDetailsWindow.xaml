<!-- DD296. What a container is called and drawn as, edited where FreeHarbor can always write: its own
     store on this machine. The layout is docs/specs/DD294-containers-redesign.md, section 6; what is
     fixed there is the identity block, a source beside every field, and no confirmation on Save.

     ThemeMode stays in markup and the keyed styles stay in this window, for the two reasons
     LogWindow.xaml states and the window-chrome skill measured: either one moved behaves
     differently. -->
<Window x:Class="FreeHarbor.Tray.Ui.EditDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FreeHarbor.Tray.Ui"
        x:ClassModifier="internal"
        Title="Edit details"
        Width="980" SizeToContent="Height"
        MinWidth="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ThemeMode="System"
        FontFamily="{x:Static ui:Palette.Body}">

    <Window.Resources>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- DD333: a field's label is title-case and bold, as the board labels it; the overline is
             kept for the panels that caption a region rather than a field. -->
        <Style x:Key="Overline" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Source" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="10,16,0,6" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Identity, always: what is being edited and where it came from. -->
        <Border Padding="20,16,20,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="16" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <!-- DD333: the project's file in mono, each file merged over it by name, and the two
                     verbs on the same line rather than at the far edge. -->
                <StackPanel x:Name="FilesRow" Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="Files" FontSize="12" VerticalAlignment="Center"
                               FontFamily="{x:Static ui:Palette.Mono}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="MoreFiles" FontSize="12" VerticalAlignment="Center" Margin="6,0,4,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Content="Copy path" Click="CopyPath" Style="{StaticResource Small}" />
                    <Button Content="Open folder" Click="OpenFolder" Style="{StaticResource Small}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The project and each of its services, so a whole project is named in one sitting.
             Moving along it keeps what was typed for the one being left. -->
        <!-- DD333: captioned PROJECT and SERVICES, each item its 24 px tile and its title over
             service · container in mono, the selected one on the card's fill and stroke. -->
        <ListBox Grid.Column="0" x:Name="Rail" Margin="12,8,0,0" BorderThickness="0"
                 Background="Transparent" SelectionChanged="RailChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontSize="11" Margin="8,10,0,6"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasHeading}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border x:Name="Hit" CornerRadius="6" Padding="8,6" BorderThickness="1"
                                            BorderBrush="Transparent" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hit" Property="Background"
                                                Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Hit" Property="Background"
                                                Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                        <Setter TargetName="Hit" Property="BorderBrush"
                                                Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0"
                                VerticalAlignment="Center" Background="{Binding Row.TileFill}">
                            <Grid>
                                <TextBlock Text="{Binding Row.TileGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{x:Static ui:Palette.TileInk}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Row.TileLetter}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{x:Static ui:Palette.TileInk}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Row.TilePicture}" Width="16" Height="16" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Row.Title}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                       FontFamily="{x:Static ui:Palette.Mono}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Caption}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Margin="20,6,20,0">
            <!-- The row as it will be drawn, redrawn as the fields change. -->
            <!-- DD333: the Editing strip, in the form it describes: the kind as a chip, the name in
                 bold mono, then where it came from and what a save is keyed by. -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="EDITING" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid Margin="10,0,10,0" VerticalAlignment="Center">
                    <Border CornerRadius="10" Opacity="0.25" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="EditingKind" Margin="10,2" FontSize="12"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
                <TextBlock x:Name="EditingName" FontWeight="Bold" VerticalAlignment="Center"
                           FontFamily="{x:Static ui:Palette.Mono}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="Identity" Margin="0,8,0,0" FontSize="12"
                       TextTrimming="CharacterEllipsis" FontFamily="{x:Static ui:Palette.Mono}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="KeyNote" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <!-- DD333: the preview is a panel, captioned on its left, so it reads as a sample of the
                 row and not as one more field. -->
            <Border Margin="0,14,0,0" Padding="16,12" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="PREVIEW" FontSize="11" Margin="0,0,24,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Border x:Name="Tile" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10"
                        Margin="0,0,10,0">
                    <Grid>
                        <TextBlock x:Name="TileGlyph" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{x:Static ui:Palette.TileInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="TileLetter" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{x:Static ui:Palette.TileInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="TilePicture" Width="26" Height="26" Stretch="Uniform" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PreviewTitle" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="PreviewDescription" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
            </Border>

            <!-- Each field says where its value comes from, and Reset goes back to that. -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset" Click="ResetIcon" Margin="8,10,0,0"
                        Style="{StaticResource Small}" />
                <TextBlock Text="Icon" Style="{StaticResource Caption}" />
                <TextBlock x:Name="IconSource" Style="{StaticResource Source}" />
            </DockPanel>
            <!-- DD333: every bundled glyph as a square button, the chosen one outlined in the accent,
                 then Choose file as a dashed button: a picture to point at rather than a name to read
                 out of a list. A ListBox, so the code that fills and reads it is the ComboBox's. -->
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Click="ChooseFile" Cursor="Hand" VerticalAlignment="Top"
                        Margin="6,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Rectangle x:Name="Hit" RadiusX="6" RadiusY="6" StrokeThickness="1"
                                           StrokeDashArray="3 2" Fill="Transparent"
                                           Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <TextBlock Text="Choose file…" Margin="12,9" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hit" Property="Fill"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <ListBox x:Name="IconBox" SelectionChanged="FieldChanged" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="ToolTip" Value="{Binding Label}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Hit" MinWidth="36" Height="36" Margin="0,0,6,6" Padding="8,0"
                                                CornerRadius="6" BorderThickness="1"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Hit" Property="Background"
                                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Hit" Property="BorderBrush"
                                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                <Setter TargetName="Hit" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Words}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset" Click="ResetTitle" Margin="8,10,0,0"
                        Style="{StaticResource Small}" />
                <TextBlock Text="Title" Style="{StaticResource Caption}" />
                <TextBlock x:Name="TitleSource" Style="{StaticResource Source}" />
            </DockPanel>
            <TextBox x:Name="TitleBox" MaxLength="60" TextChanged="FieldChanged" />

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset" Click="ResetDescription" Margin="8,10,0,0"
                        Style="{StaticResource Small}" />
                <TextBlock x:Name="Counter" DockPanel.Dock="Right" Style="{StaticResource Source}" />
                <TextBlock Text="Description" Style="{StaticResource Caption}" />
                <TextBlock x:Name="DescriptionSource" Style="{StaticResource Source}" />
            </DockPanel>
            <TextBox x:Name="DescriptionBox" MaxLength="120" TextChanged="FieldChanged" />

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset" Click="ResetLinks" Margin="8,10,0,0"
                        Style="{StaticResource Small}" />
                <TextBlock Text="Links" Style="{StaticResource Caption}" />
                <TextBlock x:Name="LinksSource" Style="{StaticResource Source}" />
            </DockPanel>
            <!-- One per line, a name and then the address, the shape the files keep them in. -->
            <TextBox x:Name="LinksBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="72"
                     VerticalScrollBarVisibility="Auto" TextChanged="FieldChanged"
                     FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" />
            <TextBlock Text="One per line: a name, then the address. The first one is what Open follows."
                       FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
        </Grid>

        <!-- Where Save writes, said before it is pressed, because Save asks nothing. -->
        <Border Margin="0,20,0,0" Padding="20,12,20,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" IsCancel="True" Style="{StaticResource Action}" />
                    <Button Content="Save" IsDefault="True" Click="Save"
                            Style="{DynamicResource AccentButtonStyle}" Padding="14,5" Margin="8,0,0,0" />
                </StackPanel>
                <!-- Save to, for a compose project whose folder this machine can open. A
                     standalone container has nowhere but FreeHarbor, so it has no choice to make. -->
                <ComboBox x:Name="SaveTo" DockPanel.Dock="Right" Margin="0,0,8,0"
                          VerticalAlignment="Center" SelectionChanged="FieldChanged" />
                <!-- DD333: named, so the dropdown reads as where and not as what. -->
                <TextBlock x:Name="SaveToLabel" DockPanel.Dock="Right" Text="Save to" Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock DockPanel.Dock="Left" Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Margin="0,0,12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Lands" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="LandsDetail" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
