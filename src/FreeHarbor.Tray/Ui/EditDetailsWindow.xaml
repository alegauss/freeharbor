<!-- DD296. What a container is called and drawn as, edited where FreeHarbor can always write: its own
     store on this machine. The layout is docs/specs/DD294-containers-redesign.md, section 6; what is
     fixed there is the identity block, a source beside every field, and no confirmation on Save.

     ThemeMode stays in markup and the keyed styles stay in this window, for the two reasons
     LogWindow.xaml states and the window-chrome skill measured: either one moved behaves
     differently. -->
<Window x:Class="FreeHarbor.Tray.Ui.EditDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FreeHarbor.Tray.Ui"
        x:ClassModifier="internal"
        Title="Edit details"
        Width="640" SizeToContent="Height"
        MinWidth="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ThemeMode="System"
        FontFamily="{x:Static ui:Palette.Body}">

    <Window.Resources>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Source" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="8,14,0,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Identity, always: what is being edited and where it came from. -->
        <Border Padding="20,16,20,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="16" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <DockPanel x:Name="FilesRow" Margin="0,6,0,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Open folder" Click="OpenFolder"
                            Style="{StaticResource Small}" />
                    <Button DockPanel.Dock="Right" Content="Copy path" Click="CopyPath"
                            Style="{StaticResource Small}" />
                    <TextBlock x:Name="Files" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <TextBlock x:Name="Editing" Margin="0,12,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="Identity" Margin="0,2,0,0" FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="KeyNote" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The project and each of its services, so a whole project is named in one sitting.
             Moving along it keeps what was typed for the one being left. -->
        <ListBox Grid.Column="0" x:Name="Rail" Margin="12,12,0,0" BorderThickness="0"
                 Background="Transparent" SelectionChanged="RailChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Row.Title}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Caption}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Margin="20,6,20,0">
            <!-- The row as it will be drawn, redrawn as the fields change. -->
            <TextBlock Text="PREVIEW" Style="{StaticResource Caption}" />
            <DockPanel LastChildFill="True">
                <Border x:Name="Tile" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10"
                        Margin="0,0,10,0">
                    <Grid>
                        <TextBlock x:Name="TileGlyph" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{x:Static ui:Palette.TileInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="TileLetter" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{x:Static ui:Palette.TileInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="TilePicture" Width="26" Height="26" Stretch="Uniform" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PreviewTitle" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="PreviewDescription" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>

            <!-- Each field says where its value comes from, and Reset goes back to that. -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset" Click="ResetIcon" Margin="8,10,0,0"
                        Style="{StaticResource Small}" />
                <TextBlock Text="ICON" Style="{StaticResource Caption}" />
                <TextBlock x:Name="IconSource" Style="{StaticResource Source}" />
            </DockPanel>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Choose file…" Click="ChooseFile"
                        Style="{StaticResource Small}" />
                <ComboBox x:Name="IconBox" SelectionChanged="FieldChanged" />
            </DockPanel>

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset" Click="ResetTitle" Margin="8,10,0,0"
                        Style="{StaticResource Small}" />
                <TextBlock Text="TITLE" Style="{StaticResource Caption}" />
                <TextBlock x:Name="TitleSource" Style="{StaticResource Source}" />
            </DockPanel>
            <TextBox x:Name="TitleBox" MaxLength="60" TextChanged="FieldChanged" />

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset" Click="ResetDescription" Margin="8,10,0,0"
                        Style="{StaticResource Small}" />
                <TextBlock x:Name="Counter" DockPanel.Dock="Right" Style="{StaticResource Source}" />
                <TextBlock Text="DESCRIPTION" Style="{StaticResource Caption}" />
                <TextBlock x:Name="DescriptionSource" Style="{StaticResource Source}" />
            </DockPanel>
            <TextBox x:Name="DescriptionBox" MaxLength="120" TextChanged="FieldChanged" />

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset" Click="ResetLinks" Margin="8,10,0,0"
                        Style="{StaticResource Small}" />
                <TextBlock Text="LINKS" Style="{StaticResource Caption}" />
                <TextBlock x:Name="LinksSource" Style="{StaticResource Source}" />
            </DockPanel>
            <!-- One per line, a name and then the address, the shape the files keep them in. -->
            <TextBox x:Name="LinksBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="72"
                     VerticalScrollBarVisibility="Auto" TextChanged="FieldChanged"
                     FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" />
            <TextBlock Text="One per line: a name, then the address. The first one is what Open follows."
                       FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
        </Grid>

        <!-- Where Save writes, said before it is pressed, because Save asks nothing. -->
        <Border Margin="0,20,0,0" Padding="20,12,20,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" IsCancel="True" Style="{StaticResource Action}" />
                    <Button Content="Save" IsDefault="True" Click="Save"
                            Style="{DynamicResource AccentButtonStyle}" Padding="14,5" Margin="8,0,0,0" />
                </StackPanel>
                <!-- Save to, for a compose project whose folder this machine can open. A
                     standalone container has nowhere but FreeHarbor, so it has no choice to make. -->
                <ComboBox x:Name="SaveTo" DockPanel.Dock="Right" Margin="0,0,8,0"
                          VerticalAlignment="Center" SelectionChanged="FieldChanged" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Lands" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="LandsDetail" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
